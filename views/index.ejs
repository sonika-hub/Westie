<%- include('partials/header') %>

<style>
    /* --- RESPONSIVE CORE STYLES --- */
    
    /* Hero Section */
    .hero-minimal {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 5%;
        text-align: center;
    }

    .main-title {
        font-family: 'Cormorant Garamond', serif;
        /* Scales from 3.5rem on mobile to 10rem on desktop */
        font-size: clamp(3.5rem, 12vw, 10rem);
        line-height: 1;
        margin: 0;
    }

    /* Story Flow */
    .story-flow {
        padding: 100px 8%;
    }

    .story-node {
        display: flex;
        flex-direction: column; /* Stack by default (Mobile First) */
        align-items: center;
        margin-bottom: 80px;
        position: relative;
        gap: 30px;
    }

    .node-content {
        width: 100%;
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(15px);
        padding: 2.5rem;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.6);
        z-index: 2;
    }

    /* Voices Section */
    .voices-section {
        display: flex;
        flex-direction: column; /* Stack by default (Mobile First) */
        gap: 30px;
        padding: 0 8% 100px;
    }

    .voice-card {
        width: 100%;
        padding: 4rem 2.5rem;
        border-radius: 50px;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        position: relative;
    }

    /* Desktop Overrides (992px and up) */
    @media (min-width: 992px) {
        .story-node {
            flex-direction: row; /* Side-by-side on desktop */
            justify-content: center;
        }
        
        .node-content {
            max-width: 650px;
        }

        .voices-section {
            flex-direction: row; /* Side-by-side on desktop */
        }

        .voice-card {
            flex: 1;
        }
    }

    /* Accent Orbs Scaling */
    .node-accent {
        position: absolute;
        width: 250px;
        height: 250px;
        filter: blur(80px);
        opacity: 0.3;
        z-index: 1;
    }

    @media (max-width: 768px) {
        .node-accent {
            width: 150px;
            height: 150px;
            filter: blur(50px);
        }
        
        .btn-aesthetic {
            display: block;
            width: 90%;
            margin: 0 auto;
            text-align: center;
        }
    }
</style>

<section class="hero-minimal">
    <div class="hero-content">
        <div class="reveal-box">
            <span class="sub-label" style="letter-spacing: 5px; opacity: 0.5; font-size: 0.7rem;">A WILLIAM & EST CHRONICLE</span>
        </div>
        <h1 class="main-title">
            <span class="text-rose" style="color: var(--rose);">Serene</span> 
            <span class="text-italic" style="font-style: italic; opacity: 0.3;">&</span> 
            <span class="text-blue" style="color: var(--sky);">Soul</span>
        </h1>
        <div class="scroll-indicator" style="margin-top: 3rem;">
            <p style="font-size: 0.6rem; letter-spacing: 3px; opacity: 0.4;">SCROLL TO BEGIN</p>
        </div>
    </div>
</section>

<section class="story-flow">
    <div class="story-node">
        <div class="node-content">
            <span class="node-year" style="font-size: 0.7rem; letter-spacing: 3px; opacity: 0.4;">PHASE 01</span>
            <h2 class="node-title" style="font-family: 'Cormorant Garamond'; font-size: 2.5rem; margin: 1rem 0;">The Gravity of Shadows</h2>
            <p style="line-height: 1.8; opacity: 0.7;">Before the light, there was the weight. Two souls navigating a world that demanded they stay gray. This was the era of quiet resilience—where every breath was a battle to remain colorful in a monochrome reality.</p>
        </div>
        <div class="node-accent accent-rose" style="background: var(--rose); right: 0;"></div>
    </div>

    <div class="story-node">
        <div class="node-content">
            <span class="node-year" style="font-size: 0.7rem; letter-spacing: 3px; opacity: 0.4;">PHASE 02</span>
            <h2 class="node-title" style="font-family: 'Cormorant Garamond'; font-size: 2.5rem; margin: 1rem 0;">The Intersection</h2>
            <p style="line-height: 1.8; opacity: 0.7;">Success wasn't found in a trophy; it was found in a handshake. When Red met Blue, the spectrum changed forever. They turned their shared scars into a roadmap for a new generation of dreamers who were named <strong>Westies</strong> on 1st April 2025.</p>
        </div>
        <div class="node-accent accent-blue" style="background: var(--sky); left: 0;"></div>
    </div>
</section>

<section class="voices-section">
    <div class="voice-card rose-voice">
        <div class="quote-mark" style="font-family: serif; font-size: 5rem; opacity: 0.1; position: absolute; top: 10px; left: 30px;">“</div>
        <p class="quote-body" style="font-family: 'Cormorant Garamond'; font-style: italic; font-size: 1.8rem; line-height: 1.4; margin-bottom: 2rem; position: relative;">
            It really couldn't be anyone else but us
        </p>
        <span class="quote-sign" style="font-size: 0.65rem; letter-spacing: 3px; opacity: 0.4;">— WILLIAM JAKRAPATR</span>
    </div>

    <div class="voice-card blue-voice">
        <div class="quote-mark" style="font-family: serif; font-size: 5rem; opacity: 0.1; position: absolute; top: 10px; left: 30px;">“</div>
        <p class="quote-body" style="font-family: 'Cormorant Garamond'; font-style: italic; font-size: 1.8rem; line-height: 1.4; margin-bottom: 2rem; position: relative;">
            I think both of us would agree we can't remember what life was like before we met
        </p>
        <span class="quote-sign" style="font-size: 0.65rem; letter-spacing: 3px; opacity: 0.4;">— EST SUPHA</span>
    </div>
</section>

<div class="final-cta" style="text-align: center; padding-bottom: 100px;">
    <a href="/gallery" class="btn-aesthetic" style="text-decoration: none; color: black; border: 1px solid #000; padding: 1.2rem 3rem; border-radius: 100px; font-size: 0.7rem; letter-spacing: 3px; transition: 0.4s;">
        VIEW THE ARCHIVE
    </a>
</div>

<%- include('partials/footer') %>